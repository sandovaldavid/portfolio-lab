{
  "name": "devsandoval-portfolio",
  "version": "1.8.3-beta.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "ng": "ng",
    "dev": "vite",
    "start": "npm run dev",
    "build": "vite build",
    "watch": "vite build --watch",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage --run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,html,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\"",
    "preview": "node dist/analog/server/index.mjs",
    "audit": "pnpm audit --audit-level=high",
    "audit:fix": "pnpm audit --fix",
    "lighthouse": "lhci autorun",
    "lighthouse:upload": "lhci upload",
    "prepare": "husky",
    "report:playwright": "gh run download -n playwright-report && npx serve playwright-report",
    "report:coverage": "gh run download -n coverage-report && npx serve coverage",
    "report:lighthouse": "gh run download -n lighthouse-reports && npx serve lighthouse-results"
  },
  "private": true,
  "dependencies": {
    "@analogjs/content": "^2.6.1",
    "@analogjs/router": "^2.6.1",
    "@angular/animations": "^22.0.2",
    "@angular/common": "^22.0.2",
    "@angular/compiler": "^22.0.2",
    "@angular/core": "^22.0.2",
    "@angular/forms": "^22.0.2",
    "@angular/platform-browser": "^22.0.2",
    "@angular/platform-server": "^22.0.2",
    "@angular/router": "^22.0.2",
    "@fontsource/fira-code": "^5.2.7",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/lora": "^5.2.8",
    "@resvg/resvg-js": "^2.6.2",
    "front-matter": "^4.0.2",
    "katex": "^0.17.0",
    "marked": "^15.0.7",
    "marked-gfm-heading-id": "^4.1.1",
    "marked-highlight": "^2.2.1",
    "marked-mangle": "^1.1.10",
    "prismjs": "^1.29.0",
    "rxjs": "~7.8.0",
    "satori": "^0.26.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/platform": "^2.6.1",
    "@analogjs/vite-plugin-angular": "^2.6.1",
    "@analogjs/vitest-angular": "^2.6.1",
    "@angular/build": "^22.0.2",
    "@angular/cli": "^22.0.2",
    "@angular/compiler-cli": "^22.0.2",
    "@axe-core/playwright": "^4.10.0",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@eslint/js": "^9.39.2",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.48.0",
    "@tailwindcss/vite": "^4.1.4",
    "@testing-library/angular": "^19.0.0",
    "@testing-library/dom": "^10.4.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^25.2.2",
    "@vitest/coverage-v8": "^4.1.0",
    "@vitest/ui": "^4.1.0",
    "angular-eslint": "^22.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "h3": "^1.15.6",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "ng-mocks": "^14.15.1",
    "postcss": "^8.5.10",
    "prettier": "^3.8.1",
    "rollup-plugin-visualizer": "^5.12.0",
    "tailwindcss": "^4.1.4",
    "tinyglobby": "^0.2.17",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^7.3.5",
    "vite-tsconfig-paths": "^4.2.0",
    "vitest": "^4.1.0",
    "wait-on": "^8.0.0"
  },
  "packageManager": "pnpm@11.7.0+sha512.19cc852c120c7125760f2443ee6be0ca5b40f9f50598de1a09a1f177503e010e57c23c77646e01e761de59bf874fb22a3398c33ab9691fc13eb946b6f0f4d620"
}
